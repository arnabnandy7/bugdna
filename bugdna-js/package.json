{
  "name": "bugdna",
  "version": "1.1.2",
  "description": "Deterministic exception fingerprinting, similarity comparison, and failure tracking for Node.js",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "test": "vitest run",
    "test:compat": "vitest run test/compatibility.test.ts"
  },
  "keywords": [
    "bugdna",
    "exception",
    "error",
    "fingerprinting",
    "observability",
    "failure-tracking",
    "regression-detection"
  ],
  "author": "Arnab Nandy",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/arnabnandy7/bugdna.git",
    "directory": "bugdna-js"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.3.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.11"
  }
}
